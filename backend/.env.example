# ============================================================
# whatsAgent - backend
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017/whatsagent

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2

# ---------- Tiers de agente -> modelos OpenAI reais ----------
# mini  = utilitario barato (classificacao, extracao de ontologia, resumo, guardrails)
# sol   = atendimento inicial de NOVOS CASOS (triagem trabalhista)
# luna  = acompanhamento de CLIENTES (processo em andamento)
# terra = escalonamento (casos sensiveis: assedio, gestante, cliente insatisfeito)
MODEL_MINI=gpt-4o-mini
MODEL_SOL=gpt-4o-mini
MODEL_LUNA=gpt-4o-mini
MODEL_TERRA=gpt-4o

# ---------- Canais WhatsApp (3 numeros) ----------
# Rotulo exibido no front. O numero real e descoberto apos o pareamento do QR.
# Dois numeros atendem quem procura o escritorio; um atende quem ja e cliente.
CHANNEL_LEADS_1_LABEL=Novos Casos 01
CHANNEL_LEADS_2_LABEL=Novos Casos 02
CHANNEL_CLIENTS_1_LABEL=Clientes

# Diretorio das credenciais Baileys (gitignorado)
WA_SESSIONS_DIR=./sessions
# Responder mensagens de grupo (@g.us)
WA_ALLOW_GROUPS=false
# Auto-conectar canais ja pareados ao subir o servidor
WA_AUTO_START=true
# Delay humanizado antes de responder (ms)
WA_MIN_TYPING_MS=250
WA_MAX_TYPING_MS=900

# ---------- Guardrails ----------
GUARD_MAX_INBOUND_CHARS=4000
GUARD_MAX_OUTBOUND_CHARS=900
GUARD_RATE_LIMIT_MSGS=12
GUARD_RATE_LIMIT_WINDOW_MS=60000
# Teto de tokens por contato por dia (0 = ilimitado)
GUARD_DAILY_TOKEN_BUDGET=40000
# Teto global de tokens por dia (0 = ilimitado)
GUARD_GLOBAL_DAILY_TOKEN_BUDGET=2000000
GUARD_ALLOWED_LINK_DOMAINS=bloadv.com.br,wa.me

# ---------- Ontologia / economia de tokens ----------
# Quantas mensagens cruas acompanham o snapshot da ontologia
ONTOLOGY_RECENT_TURNS=6
# A cada N mensagens o resumo rolante e regenerado pelo tier mini
ONTOLOGY_SUMMARY_EVERY=12

# ---------- Multimodal ----------
# Transcricao de audio (Whisper)
WHISPER_MODEL=whisper-1
AUDIO_MAX_BYTES=16777216
AUDIO_MAX_SECONDS=300
# Analise de imagem (visao)
VISION_MODEL=gpt-4o-mini
# high le a imagem inteira (necessario para ler texto em documento e print)
VISION_DETAIL=high
VISION_MAX_TOKENS=700
IMAGE_MAX_BYTES=8388608
MEDIA_ENABLED=true

# ---------- Buffer / debounce por conversa ----------
# Janela de silencio antes de consolidar e responder (ms).
# Curta de proposito: quem manda uma mensagem so nao espera por quem escreve
# em varias partes. As janelas abaixo cobrem esses casos.
BUFFER_WINDOW_MS=2000
# Janela usada enquanto o contato aparece "digitando" no WhatsApp
BUFFER_TYPING_WINDOW_MS=6000
# Janela quando a frase parece cortada no meio
BUFFER_INCOMPLETE_WINDOW_MS=3500
# Teto absoluto: consolida mesmo que o contato continue digitando (ms)
BUFFER_MAX_WAIT_MS=30000
# Maximo de mensagens agrupadas numa unica interacao
BUFFER_MAX_MESSAGES=20

# ---------- Anti-loop (bot x bot) ----------
# Interacoes automaticas consecutivas antes de pausar o agente na conversa
ANTILOOP_MAX_AUTO_INTERACTIONS=6
# Respostas nossas repetidas/similares seguidas antes de pausar
ANTILOOP_MAX_REPEATS=3
# Piso de intervalo humano: respostas do contato mais rapidas que isto, repetidas, sao suspeitas (ms)
ANTILOOP_MIN_HUMAN_GAP_MS=1500
# Quantas respostas rapidas seguidas para considerar automacao
ANTILOOP_FAST_REPLY_STREAK=4

# ---------- Base de conhecimento ----------
# memory = verbetes locais (padrao) | mongo = busca semantica no Atlas Vector Search
KNOWLEDGE_BACKEND=memory
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_VECTOR_INDEX=knowledge_vector_index
KNOWLEDGE_TOP_K=2
KNOWLEDGE_MIN_SCORE=0.55

# ---------- Autenticacao do painel ----------
# Segredo do JWT. Gere um proprio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Em desenvolvimento, aceitar tambem localhost/127.0.0.1 e a rede local em
# qualquer porta (util para abrir o painel pelo celular). Padrao: true fora de producao.
CORS_ALLOW_LOCAL_NETWORK=true

# Interface de escuta. "::" abre IPv4 e IPv6; "0.0.0.0" limita a IPv4.
HOST=::

# ---------- Consulta na internet ----------
# Busca so dispara em pergunta sobre dado que muda (valor vigente, tabela do
# ano, endereco de orgao). Nunca para opinar sobre o caso da pessoa.
WEBSEARCH_ENABLED=true
WEBSEARCH_MODEL=gpt-4o-mini
WEBSEARCH_TIMEOUT_MS=6000

# ---------- Horario de atendimento (fuso de Brasilia) ----------
EXPEDIENTE_ENABLED=true
EXPEDIENTE_INICIO=08:00
EXPEDIENTE_FIM=18:30
EXPEDIENTE_DIAS=segunda,terca,quarta,quinta,sexta
# Aviso de ausencia sai no maximo uma vez a cada N horas por contato
EXPEDIENTE_AVISO_HORAS=12
